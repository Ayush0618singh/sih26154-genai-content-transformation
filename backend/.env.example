# ============================================================
# Application
# ============================================================

APP_NAME=SIH26154 GenAI Content Transformation Platform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

API_V1_PREFIX=/api/v1

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000


# ============================================================
# Gemini
# ============================================================

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash

GEMINI_EMBEDDING_MODEL=gemini-embedding-2

GEMINI_EMBEDDING_DIMENSIONS=768


# ============================================================
# Supabase
# ============================================================

SUPABASE_URL=

SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_DOCUMENT_BUCKET=documents

SUPABASE_OUTPUT_BUCKET=generated-outputs


# ============================================================
# RAG
# ============================================================

VECTOR_STORE_PROVIDER=supabase

RAG_CHUNK_SIZE=1800

RAG_CHUNK_OVERLAP=250

RAG_TOP_K=8

RAG_EMBED_CONCURRENCY=4

RAG_MIN_SIMILARITY=0.20


# ============================================================
# Legacy local Chroma fallback
#
# No longer used for final production deployment.
# Kept only for local experiments if needed.
# ============================================================

CHROMA_PERSIST_DIRECTORY=./data/chroma


# ============================================================
# Uploads
# ============================================================

MAX_UPLOAD_SIZE_MB=50

TEMP_DIRECTORY=./temp

GENERATED_DIRECTORY=./generated

OCR_PROVIDER=paddle


# ============================================================
# Authentication
# ============================================================

REQUIRE_AUTH=true


# ============================================================
# Video processing
# ============================================================

VIDEO_MAX_DURATION_SECONDS=3600

VIDEO_AGENTIC_THRESHOLD_SECONDS=300

VIDEO_GEMINI_PROCESSING_TIMEOUT_SECONDS=900

VIDEO_FFPROBE_TIMEOUT_SECONDS=30

VIDEO_FFMPEG_DECODE_TIMEOUT_SECONDS=60


# ============================================================
# Rate limiting
# ============================================================

RATE_LIMIT_ENABLED=true

RATE_LIMIT_REQUESTS=120

RATE_LIMIT_HEAVY_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=60

RATE_LIMIT_FAIL_OPEN=true

TRUST_PROXY_HEADERS=false


# ============================================================
# Terminal E2E testing
#
# Never commit real credentials.
# ============================================================

E2E_API_URL=http://127.0.0.1:8000/api/v1

E2E_TEST_EMAIL=

E2E_TEST_PASSWORD=